{
  "name": "cognigraph-ui",
  "version": "0.0.0",
  "license": "FSL-1.1-Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "COGNIGRAPH_UI_DEV_API_PORT=${COGNIGRAPH_UI_DEV_API_PORT:-3001} bun ./index.html",
    "build": "rm -rf dist && bun build ./index.html --minify --outdir=dist --public-path=/ --define process.env.COGNIGRAPH_UI_DEV_API_PORT:null",
    "check": "biome check . && tsc --noEmit",
    "check:fix": "biome check --write .",
    "test": "bun test",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@antv/g6": "^5.1.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@phosphor-icons/react": "^2.1.10",
    "antd": "^6.7.0",
    "codemirror": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@playwright/test": "^1.65.0",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
