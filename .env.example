# Copy the settings you need into .env. Never commit .env or private keys.

# Storage
COGNIGRAPH_BACKEND=native
COGNIGRAPH_NATIVE_PATH=./data/cognigraph.redb
# COGNIGRAPH_DATA_DIR=./data/tenants

# ArangoDB maintenance backend (used only when COGNIGRAPH_BACKEND=arango)
ARANGO_URL=http://127.0.0.1:8529
ARANGO_DB=cognigraph
ARANGO_USER=root
ARANGO_PASSWORD=change-me
# Indexed model filtering requires ArangoDB >= 3.12.6, --vector-index true,
# and a trained vector index. Use fallback on older servers or without one.
# COGNIGRAPH_VECTOR_SEARCH_MODE=native

# Authentication
COGNIGRAPH_AUTH_ENABLED=true
COGNIGRAPH_ADMIN_PASSWORD=change-me
COGNIGRAPH_HOST_ADMIN_PASSWORD=use-a-different-secret
COGNIGRAPH_JWT_SECRET=replace-with-at-least-32-random-bytes

# M19 signed governance. This is the unpadded base64url encoding of the
# host-wide 32-byte Ed25519 ROOT PUBLIC KEY. Never put a root or principal
# private key in server configuration. Leave unset for graph-only or historical
# M18 operation; uncommenting an invalid placeholder will fail startup.
# COGNIGRAPH_GOVERNANCE_ROOT_PUBLIC_KEY=replace-with-root-public-key

# M21 verified artifact consumption. `disabled` is the safe default. To admit
# M21 context-v4 evaluations, set `local-cas` and mount an operator-staged,
# read-only CAS at an existing absolute path. The root must contain `tenants/`;
# CogniGraph never fetches signed locations or creates/uploads staged blobs.
COGNIGRAPH_ARTIFACT_SOURCE=disabled
# COGNIGRAPH_ARTIFACT_CAS_ROOT=/var/lib/cognigraph/artifacts
# Cumulative declared lengths charged for verification reads after safe reuse;
# this is not a peak-memory/CPU limit (10k entries, 4096 digest+length pairs).
COGNIGRAPH_ARTIFACT_MAX_EVALUATION_BYTES=1073741824
# Maximum distinct bytes in one read-only M24 evidence recovery plan. The
# offline custody CLI also enforces its selected bound while copying/restoring.
COGNIGRAPH_ARTIFACT_MAX_CUSTODY_BYTES=2147483648

# Provider-free local operation
COGNIGRAPH_EMBEDDING_PROVIDER=none

# LLM completions (construction and fallback review judge). Provider selects
# openai|gemini; when unset, prefer a nonempty OPENAI_API_KEY, then GEMINI_API_KEY.
# No keys and no provider override => completions and side-views are disabled.
# An explicit provider must be valid and have its own key, or startup fails.
# Unset an override by removing/commenting it out; an empty provider is invalid.
# API keys live in .env (never committed): OPENAI_API_KEY / GEMINI_API_KEY.
# COGNIGRAPH_COMPLETION_PROVIDER=openai
# Defaults: OpenAI gpt-5.6-luna (reasoning_effort=low), Gemini gemini-3.8-flash.
# COGNIGRAPH_COMPLETION_MODEL=gpt-5.6-luna
# Server and harnesses share these optional provider-specific completion URLs.
# Use an absolute HTTP(S) base URL without a query or fragment. Trailing slashes
# are normalized; blank models/URLs use the selected provider's defaults.
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Dedicated review judges are OpenAI providers even when completion uses Gemini.
# Both share OPENAI_API_KEY and the validated OPENAI_BASE_URL above. A nonempty
# dedicated model requires a nonempty OpenAI key, or startup fails before stores
# open. Unset/blank primary => completion fallback; unset/blank partner => no A+.
# These placeholders require separately qualified models and matching review policy.
# COGNIGRAPH_JUDGE_MODEL=qualified-primary-model
# COGNIGRAPH_JUDGE_PARTNER_MODEL=qualified-partner-model

# Side-views (context-expansion Q&A) resolve SEPARATELY, so the 10-20
# generations per document can run on a cheaper model. Unset => inherit the
# completion provider/model. Current Gemini default: gemini-3.8-flash.
# See docs/decisions/decision_sideviews_provider_and_benchmark.md for the
# current model choice and the separate historical 2026-07-20 benchmark.
# An explicit side-view provider uses its own default model unless
# COGNIGRAPH_SIDEVIEWS_MODEL is set; its configuration errors also fail startup.
# COGNIGRAPH_SIDEVIEWS_PROVIDER=gemini
# COGNIGRAPH_SIDEVIEWS_MODEL=gemini-3.8-flash
