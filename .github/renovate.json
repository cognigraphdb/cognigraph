{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": [
    "develop"
  ],
  "enabledManagers": [
    "cargo",
    "npm",
    "github-actions"
  ],
  "ignorePaths": [
    "vendor/**"
  ],
  "automerge": false,
  "timezone": "Europe/Bucharest",
  "schedule": [
    "* 0-3 * * 1"
  ],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "packageRules": [
    {
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "React stack"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "codemirror",
        "@codemirror/**",
        "@lezer/**"
      ],
      "groupName": "CodeMirror stack"
    }
  ]
}
