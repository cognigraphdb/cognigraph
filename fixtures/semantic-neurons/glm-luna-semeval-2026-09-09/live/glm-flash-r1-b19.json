            "_key": "semeval-glm-flash-r1-b19-semeval-8967",
            "chunk_id": "semeval-8967",
            "construction_schema": "occurrence-v1",
            "content_hash": "sha256:5e73f95f27e5159b1d942a13d44da6e37fea6bccc244527b296fca6ce9b479e9",
            "created_at": "2026-09-09T12:35:12.133790+00:00",
            "space_id": "semeval-glm-flash-r1-b19",
            "text": "Another 40 million people have been pushed into hunger this year.",
            "title": "Relation benchmark excerpt",
            "updated_at": "2026-09-09T12:35:12.133790+00:00"
          },
          {
