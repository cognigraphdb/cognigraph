            "chunk_id": "semeval-9044",
            "construction_schema": "occurrence-v1",
            "content_hash": "sha256:39b558aebb9150af233d01dfc5fefae51ce8d8104835a171b38ea93cee6e3ad8",
            "created_at": "2026-09-09T12:35:12.133795+00:00",
            "space_id": "semeval-glm-flash-r1-b19",
            "text": "A bottle full of milk that has been left sitting out in a warm room quickly breeds more bacteria than a newborn can handle.",
            "title": "Relation benchmark excerpt",
            "updated_at": "2026-09-09T12:35:12.133795+00:00"
          },
          {
