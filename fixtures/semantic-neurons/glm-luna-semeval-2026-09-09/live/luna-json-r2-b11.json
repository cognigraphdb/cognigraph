            "created_at": "2026-09-09T12:45:23.957934+00:00",
            "space_id": "semeval-luna-json-r2-b11",
            "text": "I grew up with milk in a sack.",
            "title": "Relation benchmark excerpt",
            "updated_at": "2026-09-09T12:45:23.957934+00:00"
          },
