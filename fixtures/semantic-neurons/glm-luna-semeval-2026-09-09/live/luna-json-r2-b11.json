            "created_at": "2026-09-09T12:45:23.957918+00:00",
            "space_id": "semeval-luna-json-r2-b11",
            "text": "Our whole evening was centered on the topic of courage.",
            "title": "Relation benchmark excerpt",
            "updated_at": "2026-09-09T12:45:23.957918+00:00"
          },
          {
            "_id": "chunks/semeval-luna-json-r2-b11-semeval-9035",
