            "created_at": "2026-09-09T13:25:37.950960+00:00",
            "space_id": "semeval-terra-low-r1-b10",
            "text": "His paper narrated the discovery chronologically.",
            "title": "Relation benchmark excerpt",
            "updated_at": "2026-09-09T13:25:37.950960+00:00"
          },
          {
            "_id": "chunks/semeval-terra-low-r1-b10-semeval-9082",
            "_key": "semeval-terra-low-r1-b10-semeval-9082",
            "chunk_id": "semeval-9082",
            "construction_schema": "occurrence-v1",
