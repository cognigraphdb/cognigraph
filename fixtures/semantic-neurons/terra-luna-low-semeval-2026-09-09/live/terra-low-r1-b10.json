            "created_at": "2026-09-09T13:25:37.950977+00:00",
            "space_id": "semeval-terra-low-r1-b10",
            "text": "A user activates the device with the power-on button.",
            "title": "Relation benchmark excerpt",
            "updated_at": "2026-09-09T13:25:37.950977+00:00"
          },
          {
            "_id": "chunks/semeval-terra-low-r1-b10-semeval-9198",
            "_key": "semeval-terra-low-r1-b10-semeval-9198",
            "chunk_id": "semeval-9198",
            "construction_schema": "occurrence-v1",
