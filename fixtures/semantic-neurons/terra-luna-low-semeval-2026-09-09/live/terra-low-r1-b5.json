            "content_hash": "sha256:487e13f485d17441c975bf950e58a5c7026a02f6a78f344726f570a450d88817",
            "created_at": "2026-09-09T13:23:35.897112+00:00",
            "space_id": "semeval-terra-low-r1-b5",
            "text": "Last night, my friend ran into a legendary surfer at a bar.",
            "title": "Relation benchmark excerpt",
            "updated_at": "2026-09-09T13:23:35.897112+00:00"
          },
          {
            "_id": "chunks/semeval-terra-low-r1-b5-semeval-8413",
