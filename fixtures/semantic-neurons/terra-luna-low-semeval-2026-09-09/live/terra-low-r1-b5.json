            "chunk_id": "semeval-8413",
            "construction_schema": "occurrence-v1",
            "content_hash": "sha256:81f46543d69f9d71882866a09c9446292121f6cef3d6d6288662860e207ef434",
            "created_at": "2026-09-09T13:23:35.897113+00:00",
            "space_id": "semeval-terra-low-r1-b5",
            "text": "Transport authorities in the Western Cape have warned of hefty fines for motorists who ignore dedicated lane for buses and minibus taxis on the road.",
            "title": "Relation benchmark excerpt",
            "updated_at": "2026-09-09T13:23:35.897113+00:00"
          },
          {
            "_id": "chunks/semeval-terra-low-r1-b5-semeval-8527",
