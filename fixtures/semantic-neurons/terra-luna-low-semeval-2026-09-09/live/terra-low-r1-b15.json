            "chunk_id": "semeval-10593",
            "construction_schema": "occurrence-v1",
            "content_hash": "sha256:95632b75dd80d79d38012d7cf586d9d5de55707ea797eba025dcaa7bfaa5ca60",
            "created_at": "2026-09-09T13:28:31.346695+00:00",
            "space_id": "semeval-terra-low-r1-b15",
            "text": "In the years following, Detroit's population fell from a peak of roughly 1.8 million in 1950 to about half that number today.",
            "title": "Relation benchmark excerpt",
            "updated_at": "2026-09-09T13:28:31.346695+00:00"
          },
          {
