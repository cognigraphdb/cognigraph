            "construction_schema": "occurrence-v1",
            "content_hash": "sha256:667e178ed57e13872d18019e50b054420c5fde90f3663724f308c6f080c0f57a",
            "created_at": "2026-09-09T13:28:14.939506+00:00",
            "space_id": "semeval-luna-low-r1-b15",
            "text": "Although the clauses were invented by the framers to serve common values, there is some tension between the two.",
            "title": "Relation benchmark excerpt",
            "updated_at": "2026-09-09T13:28:14.939506+00:00"
          },
          {
            "_id": "chunks/semeval-luna-low-r1-b15-semeval-9392",
