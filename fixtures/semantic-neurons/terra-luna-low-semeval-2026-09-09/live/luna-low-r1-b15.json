            "chunk_id": "semeval-10456",
            "construction_schema": "occurrence-v1",
            "content_hash": "sha256:e5f1b87eb56c25a2381b529c234328909776438da3685d18ec2811d727236655",
            "created_at": "2026-09-09T13:28:14.939476+00:00",
            "space_id": "semeval-luna-low-r1-b15",
            "text": "The drain was only half way through the bale wall, so when it stormed, the water poured right into the straw-bales.",
            "title": "Relation benchmark excerpt",
            "updated_at": "2026-09-09T13:28:14.939476+00:00"
          },
          {
