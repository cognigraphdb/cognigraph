      "space_id": "baseline-luna-1",
      "text": "Garnet does not supply Hazel.",
      "title": "Fictional relation extraction note",
      "updated_at": "2026-09-09T11:29:01.757011+00:00"
    },
    {
      "_id": "chunks/baseline-luna-1-case-005",
      "_key": "baseline-luna-1-case-005",
      "chunk_id": "case-005",
      "construction_schema": "occurrence-v1",
