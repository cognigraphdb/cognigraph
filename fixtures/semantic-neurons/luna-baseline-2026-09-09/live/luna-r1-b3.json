      "created_at": "2026-09-09T11:29:01.757016+00:00",
      "space_id": "baseline-luna-1",
      "text": "Iris might supply Juniper if negotiations succeed.",
      "title": "Fictional relation extraction note",
      "updated_at": "2026-09-09T11:29:01.757016+00:00"
    },
    {
      "_id": "chunks/baseline-luna-1-case-006",
      "_key": "baseline-luna-1-case-006",
      "chunk_id": "case-006",
      "construction_schema": "occurrence-v1",
